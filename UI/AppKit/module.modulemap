module Ladyworm [system] {
    requires cplusplus
    requires objc_arc

    explicit module WebView {
        header "Interface/LadywormWebView.h"
        export *
    }

    explicit module WebViewWindow {
        header "Interface/LadywormWebViewWindow.h"
        export *
    }

    explicit module WebViewApplication {
        header "../../Libraries/LibWebView/Application.h"
        export *
    }
}
